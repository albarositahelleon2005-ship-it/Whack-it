/**
 * icono.rc - Recursos de Windows para el ejecutable de Whack it.
 *
 * Este archivo no es codigo C++: es un "script de recursos" que windres
 * convierte en datos y el enlazador mete DENTRO del .exe. Gracias a el, el
 * icono viaja junto con el programa y no hace falta repartir el .ico aparte.
 *
 * El recurso NO se llama GLFW_ICON a proposito. Windows usa el primer icono
 * que encuentre para el Explorador (el .exe y sus accesos directos), pero
 * GLFW -la libreria de ventanas que trae raylib- solo busca ese nombre para
 * ponerlo en la ventana y la barra de tareas mientras el juego corre. Con
 * otro nombre, el .exe conserva su icono y la ventana sale con el normal de
 * Windows, que es como lo pidio el equipo. Para volver a ponerlo en la
 * ventana, basta con renombrarlo a GLFW_ICON.
 */

ICONO_EXE ICON "icono.ico"

/* Datos que Windows muestra en Propiedades > Detalles del archivo. */

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 080a = espanol (Mexico), 04b0 = Unicode */
        BLOCK "080a04b0"
        BEGIN
            VALUE "CompanyName",      "Universidad de Sonora"
            VALUE "FileDescription",  "Whack it"
            VALUE "FileVersion",      "1.0"
            VALUE "InternalName",     "WhackIt"
            VALUE "OriginalFilename", "WhackIt.exe"
            VALUE "ProductName",      "Whack it"
            VALUE "ProductVersion",   "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x080a, 1200
    END
END
